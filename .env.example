# URL pública del sitio (opcional en Vercel: se usa VERCEL_PROJECT_PRODUCTION_URL automáticamente)
NEXT_PUBLIC_SITE_URL=

# Webhook que recibe los mensajes de contacto (p. ej. un workflow de n8n). Sin esto, se loguean en consola.
CONTACT_WEBHOOK_URL=
# Secreto opcional enviado como "Authorization: Bearer <secreto>" para validar en el webhook
CONTACT_WEBHOOK_SECRET=
